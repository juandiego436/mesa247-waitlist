# Perfil STAGING - plantilla. El fichero real NO se versiona.
# En Cloud Run nada de esto vive en un fichero: son variables de entorno y
# secretos inyectados por Secret Manager.
MESA247_DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@/waitlist_staging?unix_socket=/cloudsql/PROYECTO:REGION:INSTANCIA&charset=utf8mb4
MESA247_DOCS_ENABLED=false
MESA247_LOG_LEVEL=INFO
MESA247_CORS_ORIGINS=https://staging.lista.mesa247.pe
MESA247_HOST_TOKEN=CAMBIAR-token-por-local
MESA247_DB_POOL_SIZE=5
