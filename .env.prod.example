# Perfil PROD - plantilla. El fichero real NO EXISTE: en Cloud Run todo llega
# como variable de entorno, y el token de anfitrion desde Secret Manager.
#
# El perfil se niega a arrancar si docs_enabled sigue activo, si la base es
# SQLite, si el token es el de ejemplo o si CORS lleva comodin. Preferimos que
# el despliegue falle a que arranque mal.
MESA247_DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@/waitlist?unix_socket=/cloudsql/PROYECTO:REGION:INSTANCIA&charset=utf8mb4
MESA247_DOCS_ENABLED=false
MESA247_LOG_LEVEL=WARNING
MESA247_CORS_ORIGINS=https://lista.mesa247.pe
MESA247_HOST_TOKEN=desde-secret-manager
MESA247_DB_POOL_SIZE=10
